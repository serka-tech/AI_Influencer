# ── Telegram ──
# BotFather'dan aldığın bot token'ı
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
# (Opsiyonel) Sadece bu kullanıcı botu kullanabilsin — kendi Telegram user ID'in
ADMIN_CHAT_ID=

# ── OpenAI (Senaryo Agent) ──
OPENAI_API_KEY=<OPENAI_API_KEY>
# Senaryo üretim modeli (n8n'de gpt-5.1 idi)
OPENAI_SCENARIO_MODEL=gpt-5.1

# ── Kie AI (Nano Banana Pro görsel + Veo 3.1 / Kling 3.0 video) ──
KIE_API_KEY=<KIE_API_KEY>
KIE_BASE_URL=https://api.kie.ai/api/v1/

# ── Video Motoru ──
# veo   : Veo 3.1 image-to-video, kendi sesiyle (tek servis, stabil) — varsayılan.
# kling : Kling 3.0 sessiz video + ElevenLabs Türkçe ses + Replicate lip-sync.
VIDEO_ENGINE=veo

# ── Replicate (concat + kling motorunda lip-sync) ──
REPLICATE_API_TOKEN=<REPLICATE_API_TOKEN>

# ── ElevenLabs (sadece VIDEO_ENGINE=kling için zorunlu — dış Türkçe seslendirme) ──
ELEVENLABS_API_KEY=
# Türkçe kadın sesi voice ID (boşsa fallback ses kullanılır)
ELEVENLABS_VOICE_ID=

# ── ImgBB (opsiyonel — lokal görseli public URL'e çevirmek için) ──
IMGBB_API_KEY=

# ── Sabit Karakter ──
# Referans görsel (Nano Banana Pro'ya "bu kişiyi koru" referansı). Boş bırakılırsa
# config.py'deki varsayılan ImgBB URL'i kullanılır.
REFERENCE_IMAGE_URL=https://i.ibb.co/bjcz7Ybv/Model-Referans-Sayfa-1.png
# Karakter konsepti. Boş bırakırsan prompts/karakter_konsept.txt dosyasından okunur.
CHARACTER_DETAILS=

# ── Üretim Ayarları ──
# Kie kredisinin yaklaşık USD karşılığı (maliyet gösterimi için; satın alma paketine göre)
KIE_CREDIT_TO_USD=0.00125
ASPECT_RATIO=9:16
IMAGE_RESOLUTION=1K
MIN_SCENES=2
MAX_SCENES=6

# ── Upload-Post (opsiyonel — sosyal medya yayını) ──
# İkisi de doluysa yayınlama aktif olur; boşsa video sadece Telegram'a teslim edilir.
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=
PUBLISH_PLATFORMS=tiktok,instagram,youtube
